{
  "name": "LIS2DW12 Accelerometer",
  "author": "WMB+",
  "pins": [ "VCC", "GND", "SCL", "SDA", "INT1" ],
  "controls": [
    {
      "id": "pattern",
      "label": "Motion pattern (0 manual, 1 quiet, 2 vibration, 3 knock, 4 cup, 5 double tap)",
      "type": "range",
      "min": 0,
      "max": 5,
      "step": 1
    },
    {
      "id": "amplitudeG",
      "label": "Pattern amplitude (g)",
      "type": "range",
      "min": 0,
      "max": 2,
      "step": 0.05
    },
    {
      "id": "ax",
      "label": "X acceleration (g)",
      "type": "range",
      "min": -4,
      "max": 4,
      "step": 0.01
    },
    {
      "id": "ay",
      "label": "Y acceleration (g)",
      "type": "range",
      "min": -4,
      "max": 4,
      "step": 0.01
    },
    {
      "id": "az",
      "label": "Z acceleration (g)",
      "type": "range",
      "min": -4,
      "max": 4,
      "step": 0.01
    },
    {
      "id": "tempC",
      "label": "Temperature (C)",
      "type": "range",
      "min": -40,
      "max": 85,
      "step": 1
    },
    {
      "id": "dataReady",
      "label": "Data ready",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 1
    }
  ]
}
