{
  "name": "HX711 10/80 SPS Load Cell ADC",
  "author": "WMB+",
  "pins": [ "VCC", "GND", "DT", "SCK", "RATE" ],
  "controls": [
    {
      "id": "sps",
      "label": "HX711 mode",
      "type": "range",
      "min": 10,
      "max": 80,
      "step": 70
    },
    {
      "id": "useRatePin",
      "label": "Use RATE pin (HIGH=80 SPS, LOW=10 SPS)",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 1
    },
    {
      "id": "actualSps",
      "label": "Actual samples/sec",
      "type": "range",
      "min": 1,
      "max": 120,
      "step": 0.01
    },
    {
      "id": "jitterMicros",
      "label": "Deterministic jitter (us)",
      "type": "range",
      "min": 0,
      "max": 1000,
      "step": 10
    },
    {
      "id": "weight",
      "label": "Initial weight (g)",
      "type": "range",
      "min": -20,
      "max": 300,
      "step": 0.1
    },
    {
      "id": "loadAfterMs",
      "label": "Switch to load after ms",
      "type": "range",
      "min": 0,
      "max": 60000,
      "step": 100
    },
    {
      "id": "loadWeight",
      "label": "Delayed load weight (g)",
      "type": "range",
      "min": -20,
      "max": 300,
      "step": 0.1
    },
    {
      "id": "offset",
      "label": "Offset counts",
      "type": "range",
      "min": -1000000,
      "max": 1000000,
      "step": 100
    },
    {
      "id": "countsPerGram",
      "label": "Counts/g",
      "type": "range",
      "min": 100,
      "max": 20000,
      "step": 10
    },
    {
      "id": "glitchEvery",
      "label": "Glitch every N samples",
      "type": "range",
      "min": 0,
      "max": 500,
      "step": 1
    },
    {
      "id": "glitchCounts",
      "label": "Glitch counts",
      "type": "range",
      "min": -2000000,
      "max": 2000000,
      "step": 1000
    },
    {
      "id": "missedReadyEvery",
      "label": "Miss one ready every N conversions",
      "type": "range",
      "min": 0,
      "max": 500,
      "step": 1
    }
  ]
}
