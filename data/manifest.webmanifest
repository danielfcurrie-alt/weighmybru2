{
  "name": "WMB+",
  "short_name": "WMB+",
  "id": "/app.html",
  "description": "WeighMyBru+ scale controls, StopMyBru target stop, calibration, diagnostics, and OTA.",
  "start_url": "/app.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "background_color": "#0b1115",
  "theme_color": "#47a864",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icons/wmb-plus-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/wmb-plus-512.jpg",
      "sizes": "512x512",
      "type": "image/jpeg"
    },
    {
      "src": "/icons/wmb-plus-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "StopMyBru",
      "short_name": "Stop",
      "description": "Open StopMyBru target stop controls.",
      "url": "/stopmybru.html",
      "icons": [{ "src": "/icons/wmb-plus-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Calibration",
      "short_name": "Calibrate",
      "description": "Open scale calibration.",
      "url": "/calibration.html",
      "icons": [{ "src": "/icons/wmb-plus-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Updates",
      "short_name": "Updates",
      "description": "Open firmware and web UI updates.",
      "url": "/updates.html",
      "icons": [{ "src": "/icons/wmb-plus-192.png", "sizes": "192x192" }]
    },
    {
      "name": "More Data",
      "short_name": "Data",
      "description": "Open WMB+ live diagnostics.",
      "url": "/app.html?view=data",
      "icons": [{ "src": "/icons/wmb-plus-192.png", "sizes": "192x192" }]
    }
  ]
}
