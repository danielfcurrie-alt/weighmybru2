{
  "name": "WMB+",
  "short_name": "WMB+",
  "description": "WeighMyBru+ scale controls, StopMyBru target stop, calibration, diagnostics, and OTA.",
  "start_url": "/app.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1115",
  "theme_color": "#47a864",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icons/wmb-plus-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/wmb-plus-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "StopMyBru",
      "short_name": "Stop",
      "description": "Open StopMyBru target stop controls.",
      "url": "/smb.html",
      "icons": [{ "src": "/icons/wmb-plus-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Calibration",
      "short_name": "Calibrate",
      "description": "Open scale calibration.",
      "url": "/calibration.html",
      "icons": [{ "src": "/icons/wmb-plus-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Updates",
      "short_name": "Updates",
      "description": "Open firmware and web UI updates.",
      "url": "/updates.html",
      "icons": [{ "src": "/icons/wmb-plus-192.png", "sizes": "192x192" }]
    }
  ]
}
